@model IEnumerable<TPFINALFINANZAS.DTOs.GastoDto>

@{
    ViewData["Title"] = "Gastos";
}

<h1>Lista de Gastos</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Crear Nuevo Gasto</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
            <th>@Html.DisplayNameFor(model => model.Monto)</th>
            <th>@Html.DisplayNameFor(model => model.Fecha)</th>
            <th>@Html.DisplayNameFor(model => model.NombreCategoria)</th>
            <th>@Html.DisplayNameFor(model => model.NombreUsuario)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td>@Html.DisplayFor(modelItem => item.Monto)</td>
                <td>@Html.DisplayFor(modelItem => item.Fecha)</td>
                <td>@Html.DisplayFor(modelItem => item.NombreCategoria)</td>
                <td>@Html.DisplayFor(modelItem => item.NombreUsuario)</td>
                <td>
                    <a asp-action="Editar" class="btn btn-warning" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Eliminar" class="btn btn-danger" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>